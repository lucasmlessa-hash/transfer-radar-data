{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transfer-radar/schema/feed.schema.json",
  "title": "Transfer Radar feed",
  "type": "object",
  "required": [
    "version",
    "generatedAt",
    "routes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "health": {
      "$ref": "#/$defs/health"
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": [
        "id",
        "bank",
        "airline",
        "code",
        "time",
        "typical",
        "mp",
        "hist"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "bank": {
          "type": "string"
        },
        "airline": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "typical": {
          "type": "string"
        },
        "mp": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "active": {
          "type": "object",
          "required": [
            "pct",
            "endDate"
          ],
          "additionalProperties": false,
          "properties": {
            "pct": {
              "type": "number"
            },
            "endDate": {
              "type": "string",
              "format": "date"
            },
            "startDate": {
              "type": "string",
              "format": "date",
              "description": "Optional: when the window opened. Lets the client tell a bonus that started today from one running for weeks."
            }
          }
        },
        "ended": {
          "type": "object",
          "required": [
            "pct",
            "endedAt"
          ],
          "additionalProperties": false,
          "properties": {
            "pct": {
              "type": "number"
            },
            "endedAt": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "next": {
          "type": "object",
          "required": [
            "label",
            "prob"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "prob": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "hist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "w",
              "pct",
              "len"
            ],
            "additionalProperties": false,
            "properties": {
              "w": {
                "type": "string"
              },
              "pct": {
                "type": "number"
              },
              "len": {
                "type": "string"
              }
            }
          }
        },
        "p2": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "P(bonus during the 2-month stretch starting at that month). Empirical union, never composed from mp."
        },
        "wait": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Mirrors the primary forecast.horizons, not nextCampaignForecast. Public compatibility feeds retain v2 calendar-month probabilities here."
        },
        "upcoming": {
          "type": "object",
          "required": [
            "pct",
            "startDate",
            "endDate"
          ],
          "additionalProperties": false,
          "properties": {
            "pct": {
              "type": "number"
            },
            "startDate": {
              "type": "string",
              "format": "date"
            },
            "endDate": {
              "type": "string",
              "format": "date"
            }
          },
          "description": "Announced but not yet running. Mutually exclusive with `active` — the source table lists current AND upcoming bonuses, and treating an unstarted one as live tells the user to transfer for nothing."
        },
        "forecast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelVersion",
            "issuedAt",
            "evidence",
            "horizons"
          ],
          "properties": {
            "modelVersion": {
              "type": "string",
              "minLength": 1
            },
            "issuedAt": {
              "type": "string",
              "format": "date-time"
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "windowCount",
                "firstDate",
                "lastDate",
                "spanMonths",
                "level"
              ],
              "properties": {
                "windowCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "firstDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "lastDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                },
                "spanMonths": {
                  "type": "integer",
                  "minimum": 0
                },
                "level": {
                  "enum": [
                    "limited",
                    "established_history"
                  ]
                }
              }
            },
            "horizons": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "months",
                  "startDate",
                  "endDate",
                  "probability"
                ],
                "properties": {
                  "months": {
                    "enum": [
                      1,
                      3,
                      6
                    ]
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "days": {
                    "enum": [
                      30,
                      90,
                      180
                    ]
                  }
                }
              }
            },
            "target": {
              "const": "campaign_start"
            },
            "horizonMode": {
              "const": "rolling_days"
            },
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "campaignsThisYear",
                "campaignsLast365Days",
                "annualMedian",
                "completeYears",
                "daysSinceLastStart",
                "daysSinceLastEnd",
                "medianIntervalDays",
                "recentIntervalsDays",
                "nextCampaignOrdinal"
              ],
              "properties": {
                "campaignsThisYear": {
                  "type": "integer",
                  "minimum": 0
                },
                "campaignsLast365Days": {
                  "type": "integer",
                  "minimum": 0
                },
                "completeYears": {
                  "type": "integer",
                  "minimum": 0
                },
                "nextCampaignOrdinal": {
                  "type": "integer",
                  "minimum": 1
                },
                "daysSinceLastStart": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "daysSinceLastEnd": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "annualMedian": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "medianIntervalDays": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "recentIntervalsDays": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "target"
                ],
                "properties": {
                  "target": {
                    "const": "campaign_start"
                  }
                }
              },
              "then": {
                "required": [
                  "target",
                  "horizonMode",
                  "context"
                ],
                "properties": {
                  "horizons": {
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "required": [
                        "days"
                      ]
                    },
                    "prefixItems": [
                      {
                        "properties": {
                          "months": {
                            "const": 1
                          },
                          "days": {
                            "const": 30
                          }
                        }
                      },
                      {
                        "properties": {
                          "months": {
                            "const": 3
                          },
                          "days": {
                            "const": 90
                          }
                        }
                      },
                      {
                        "properties": {
                          "months": {
                            "const": 6
                          },
                          "days": {
                            "const": 180
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "horizonMode"
                      ]
                    },
                    {
                      "required": [
                        "context"
                      ]
                    }
                  ]
                },
                "properties": {
                  "horizons": {
                    "items": {
                      "not": {
                        "required": [
                          "days"
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "modelVersion"
                ],
                "properties": {
                  "modelVersion": {
                    "const": "recurrence-hazard-v3"
                  }
                }
              },
              "then": {
                "required": [
                  "target",
                  "horizonMode",
                  "context"
                ]
              }
            }
          ]
        },
        "offerEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checkedAt",
            "observations"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed",
                "conflict",
                "carried"
              ]
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time"
            },
            "observations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceId",
                  "url",
                  "pct",
                  "bonusKind"
                ],
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  "pct": {
                    "type": "number",
                    "minimum": 0
                  },
                  "bonusKind": {
                    "enum": [
                      "fixed",
                      "up_to",
                      "unknown"
                    ]
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "conditionsText": {
                    "type": "string",
                    "maxLength": 600
                  }
                }
              }
            }
          }
        },
        "nextCampaignForecast": {
          "$ref": "#/$defs/route/properties/forecast",
          "description": "Additive v3 forecast for new campaign starts. The primary forecast and wait retain their legacy meaning for older clients.",
          "required": [
            "target",
            "horizonMode",
            "context"
          ],
          "properties": {
            "modelVersion": {
              "const": "recurrence-hazard-v3"
            },
            "target": {
              "const": "campaign_start"
            },
            "horizonMode": {
              "const": "rolling_days"
            }
          }
        }
      }
    },
    "sourceHealth": {
      "type": "object",
      "required": [
        "status",
        "checkedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded",
            "failed"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSuccessAt": {
          "type": "string",
          "format": "date-time"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "undated": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        }
      }
    },
    "health": {
      "type": "object",
      "required": [
        "status",
        "sources",
        "carriedForwardRoutes"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded"
          ]
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceHealth"
          }
        },
        "directories": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceHealth"
          }
        },
        "carriedForwardRoutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

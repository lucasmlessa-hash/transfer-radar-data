{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transfer-radar/schema/partners.schema.json",
  "title": "Transfer Radar partner directory",
  "type": "object",
  "required": [
    "version",
    "banks",
    "airlineDomains",
    "bankDomains",
    "airlineValues",
    "directory"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "banks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "short",
          "bg",
          "fg"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "short": {
            "type": "string"
          },
          "bg": {
            "type": "string"
          },
          "fg": {
            "type": "string"
          }
        }
      }
    },
    "airlineDomains": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "airlineIconUrls": {
      "description": "OPTIONAL. Airline code -> absolute logo URL, overriding the favicon URL the client would otherwise build from airlineDomains. Present only for airlines whose favicon service result is wrong or missing.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "transferTimes": {
      "description": "OPTIONAL. Bank code -> airline code -> transfer speed display string (e.g. \"INSTANT\", \"~1 DAY\"). Keyed by both because speed varies by bank for the same airline. A missing pair means no published figure; the feed falls back to an em dash.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "airlineValueMeta": {
      "description": "Provenance for USD cents per destination point. Editorial means keep one dated observation per publisher. ALL uses the official EUR hotel discount and a dated USD/EUR fixing.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "currency",
          "asOf",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "currency": {
            "enum": [
              "USD",
              "BRL",
              "EUR"
            ]
          },
          "asOf": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "sourceValue": {
            "type": "number",
            "description": "OPTIONAL. The value as published in its native currency (e.g. BRL per point), so the USD figure can be re-derived when the FX rate moves."
          },
          "sourceCurrency": {
            "enum": [
              "USD",
              "BRL",
              "EUR"
            ],
            "description": "OPTIONAL. Currency of sourceValue."
          },
          "fxRate": {
            "type": "number",
            "description": "USD per EUR for official ALL redemption, BRL per USD for Brazilian valuations."
          },
          "estimate": {
            "type": "boolean",
            "description": "True for a published or derived valuation estimate; never a guaranteed cash value."
          },
          "method": {
            "enum": [
              "editorial-mean",
              "official-fx"
            ]
          },
          "fxSource": {
            "type": "string",
            "pattern": "^https://"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "source",
                "value",
                "asOf",
                "checkedOn",
                "validUntil"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "asOf": {
                  "type": "string",
                  "format": "date"
                },
                "checkedOn": {
                  "type": "string",
                  "format": "date"
                },
                "validUntil": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      }
    },
    "bankDomains": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "airlineValues": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "air",
          "hotel"
        ],
        "additionalProperties": false,
        "properties": {
          "air": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/partnerTuple"
            }
          },
          "hotel": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/partnerTuple"
            }
          }
        }
      }
    },
    "transferTimeMeta": {
      "description": "Optional provenance of observed transfer times. Bank and airline must have a matching transferTimes entry. Estimates are not guaranteed deadlines.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "source",
            "asOf",
            "estimate"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "asOf": {
              "type": "string",
              "format": "date"
            },
            "estimate": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ratioTiers": {
      "description": "Optional card-specific transfer ratios keyed by bank and exact air or hotel directory name. Each route must use an em dash in the directory. Each distinct card group is described for the reader in Portuguese.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "ratio",
              "cards"
            ],
            "additionalProperties": false,
            "properties": {
              "ratio": {
                "type": "string",
                "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.0*[1-9][0-9]*):(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.0*[1-9][0-9]*)(?![\\s\\S])"
              },
              "cards": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "ratioProvenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source",
          "asOf"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "asOf": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "partnerTuple": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "items": false
    }
  }
}

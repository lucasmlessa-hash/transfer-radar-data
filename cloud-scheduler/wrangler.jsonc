{
  "name": "transfer-radar-daily-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Preparation is inert. Only the explicitly selected production environment
  // installs a clock. No KV, database, paid plan, or public endpoint is needed.
  "triggers": { "crons": [] },
  "env": {
    "production": {
      "name": "transfer-radar-daily-scheduler",
      // Prepared locally, not activated: collect every 4h at 01/05/09/13/17/21 UTC.
      // Only 09 UTC refreshes references; 10 UTC recovers it and 11 UTC verifies.
      "triggers": { "crons": ["0 1,5,9,10,11,13,17,21 * * *"] }
    }
  }
}
